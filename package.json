{
  "name": "sharp-mind-ai-academic-os",
  "private": true,
  "description": "SharpMind \u2014 AI Academic OS",
  "workspaces": [
    "landing",
    "web",
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:landing": "npm --prefix landing run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build:landing && npm run build:web && npm run build:backend",
    "build:landing": "npm --prefix landing run build",
    "build:web": "npm --prefix web run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix web run start",
    "start:landing": "npm --prefix landing run start",
    "start:web": "npm --prefix web run start",
    "start:backend": "npm --prefix backend run start",
    "lint": "npm --prefix landing run lint && npm --prefix web run lint",
    "typecheck": "npm run typecheck:all",
    "typecheck:landing": "npm --prefix landing run typecheck",
    "typecheck:web": "npm --prefix web run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:all": "npm --prefix backend run typecheck && npm --prefix landing run typecheck && npm --prefix web run typecheck && npm --prefix apps/mobile run typecheck",
    "test:backend": "npm --prefix backend run test",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:test": "npm --prefix apps/mobile test",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:build:debug": "npm --prefix apps/mobile run build:debug",
    "mobile:build:qa": "npm --prefix apps/mobile run build:qa",
    "mobile:build:release": "npm --prefix apps/mobile run build:release",
    "mobile:bundle": "npm --prefix apps/mobile run bundle",
    "mobile:audit": "npm --prefix apps/mobile run audit",
    "mobile:audit:source": "npm --prefix apps/mobile run audit:source",
    "mobile:audit:artifact": "npm --prefix apps/mobile run audit:artifact",
    "mobile:check:config:release": "npm --prefix apps/mobile run check:config:release",
    "build:packages": "npm --prefix packages/types run build && npm --prefix packages/api-client run build"
  },
  "overrides": {
    "postcss": "8.5.29",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
