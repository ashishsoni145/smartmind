{
  "name": "sharp-mind-ai-academic-os",
  "private": true,
  "description": "SharpMind — AI Academic OS",
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix apps/web run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix apps/web run start",
    "start:backend": "npm --prefix backend run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:all": "npm --prefix backend run typecheck && npm --prefix apps/web run typecheck",
    "test:backend": "npm --prefix backend run test",
    "build:mobile": "npm --prefix apps/mobile run build",
    "apk:debug": "npm --prefix apps/mobile run apk:debug"
  }
}
