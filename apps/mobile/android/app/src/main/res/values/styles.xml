<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">@color/sharpmind_background</item>
        <item name="android:navigationBarColor">@color/sharpmind_background</item>
        <item name="android:windowBackground">@color/sharpmind_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="FocusInterventionTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/sharpmind_background</item>
    </style>
</resources>
