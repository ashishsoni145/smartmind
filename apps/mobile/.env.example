# PUBLIC client configuration only.
#
# These values are inlined into the React Native JavaScript bundle and therefore ship inside the
# APK/AAB. Anything here must be safe for a stranger to read out of an installed app.
#
# NEVER put a service-role key, an AI provider key (OpenRouter/Gemini/Groq/OpenAI/Anthropic), a
# database URL or password, a Razorpay/Twilio/MSG91 secret, or a signing credential in this file.
# scripts/write-public-config.mjs refuses to embed them, and scripts/security-audit.mjs fails the
# build if one reaches an artifact. Those values belong only in the backend environment - see
# backend/.env.example and backend/README.md section 3.
#
# All three values below already have committed public defaults in apps/mobile/config/production.json.
# Set them here (or in CI) only to override, e.g. to point a build at a different deployment.
# The NEXT_PUBLIC_* aliases exist so the web project's existing variables can be reused.

SHARPMIND_SUPABASE_URL=
SHARPMIND_SUPABASE_ANON_KEY=
SHARPMIND_API_URL=

# Aliases accepted with lower precedence
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=

# debug | qa | release
# Set by the Gradle build and by npm scripts; do not set it by hand for a distributed build.
#   debug   Metro-based development; permissive configuration rules
#   qa      standalone QA APK; production rules enforced
#   release Play AAB; production rules enforced
# SHARPMIND_APP_ENV=debug

# Development only. Points a DEBUG build at a backend running on the host machine
# (http://10.0.2.2:4000/api/v1) and ignores any configured API URL. Ignored by qa/release builds,
# which must always use the public HTTPS backend domain.
# SHARPMIND_USE_EMULATOR_API=1

# Release signing. Never commit the keystore; in CI these come from GitHub environment secrets and
# the decoded file is deleted after the build.
# SHARPMIND_KEYSTORE_PATH=
# SHARPMIND_KEYSTORE_PASSWORD=
# SHARPMIND_KEY_ALIAS=
# SHARPMIND_KEY_PASSWORD=
# SHARPMIND_VERSION_CODE=
# SHARPMIND_VERSION_NAME=
