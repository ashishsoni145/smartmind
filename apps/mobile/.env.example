# Public client configuration only. Never put service-role keys, OpenRouter
# management keys, admin credentials, or signing secrets in the mobile app.
#
# These are read by scripts/write-public-config.mjs and inlined into the JS bundle.
# The NEXT_PUBLIC_* names are accepted so the existing web/CI secrets can be reused.

SHARPMIND_SUPABASE_URL=
SHARPMIND_SUPABASE_ANON_KEY=
SHARPMIND_API_URL=

# Aliases
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=

# debug | release — set by the Gradle build, not by hand in production
# SHARPMIND_APP_ENV=debug

# Release signing (never commit the keystore)
# SHARPMIND_KEYSTORE_PATH=
# SHARPMIND_KEYSTORE_PASSWORD=
# SHARPMIND_KEY_ALIAS=
# SHARPMIND_KEY_PASSWORD=
# SHARPMIND_VERSION_CODE=
# SHARPMIND_VERSION_NAME=
