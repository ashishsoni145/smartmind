# Server Port & Environment
PORT=4000
NODE_ENV=development
APP_MODE=development
LOG_LEVEL=info
API_PREFIX=/api/v1

# Supabase Credentials (Server-side ONLY - Keep Service Role Key Secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Allowed CORS Origins (comma-separated or wildcard pattern in non-prod)
CORS_ORIGIN=http://localhost:3000,https://*.vercel.app

# AI Provider Configuration (Server-side ONLY)
AI_PROVIDER_PRIMARY=gemini # Options: gemini, groq, openrouter, mock
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GROQ_API_KEY=your-groq-api-key
AI_OPENROUTER_API_KEY=your-openrouter-api-key

# Transport Rate Limiting (server-side only; not a secret)
# Coarse abuse brake on the public API. The authoritative per-student AI token budget lives in
# src/ai/router/model-router.ts. State is process-local, so on a serverless deployment this bounds
# per-instance bursts rather than providing an exact global quota.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Client-safe configuration lives elsewhere.
#
# The values the web and Android clients need (public backend URL, Supabase project URL, Supabase
# anon key) are NOT server secrets:
#   - Android: apps/mobile/config/production.json (committed, public) overridable by
#     SHARPMIND_API_URL / SHARPMIND_SUPABASE_URL / SHARPMIND_SUPABASE_ANON_KEY at build time.
#   - Web: NEXT_PUBLIC_* at build time.
#
# Nothing in this file may ever be copied into a client build. SUPABASE_SERVICE_ROLE_KEY and the
# AI_*_API_KEY values are read only by this server process; the mobile config generator refuses to
# embed them and the artifact auditor fails the build if one reaches an APK/AAB.
# ---------------------------------------------------------------------------
