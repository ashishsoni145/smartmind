# Client-Facing Public URLs (Exposed to Browser/Mobile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-Side Privileged Secrets (NEVER expose to client/browser/APK/executable)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AI_PROVIDER_PRIMARY=gemini
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GROQ_API_KEY=your-groq-api-key
AI_OPENROUTER_API_KEY=your-openrouter-api-key
PORT=4000
NODE_ENV=development
APP_MODE=development
CORS_ORIGIN=http://localhost:3000
