# Client-Facing Public URLs (Exposed to Browser/Mobile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opt-in browser-only fallbacks for the web app. Leave both UNSET anywhere that is deployed.
#
# When NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are missing, the web app does NOT
# silently fall back to fake behaviour any more: sign-in is refused with an explanation and the AI
# tutor replies that it is unavailable. These two flags exist only so local development can still
# render the UI without a Supabase project, and each is separate so that turning on one does not
# quietly turn on the other.
#
#   NEXT_PUBLIC_ALLOW_LOCAL_AUTH=1   LocalAuthAdapter: accounts live in this browser's localStorage
#                                    and accept a password that is published in the source. No
#                                    server verifies anything.
#   NEXT_PUBLIC_ALLOW_LOCAL_TUTOR=1  LocalAITutorAdapter: replies are canned text chosen by tutor
#                                    mode. The question is not read, no model is called, and the
#                                    citations are invented.
#
# A value of 0/false/no/off counts as unset.
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=
NEXT_PUBLIC_ALLOW_LOCAL_TUTOR=

# Server-Side Privileged Secrets (NEVER expose to client/browser/APK/executable)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AI_PROVIDER_PRIMARY=gemini
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GROQ_API_KEY=your-groq-api-key
AI_OPENROUTER_API_KEY=your-openrouter-api-key
PORT=4000
NODE_ENV=development
APP_MODE=development
CORS_ORIGIN=http://localhost:3000
